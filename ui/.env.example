# Tour voice keys — all optional. Without any key the tour uses your browser's voice.
#   cp ui/.env.example ui/.env.local   (git-ignored), fill in a key, then restart `make demo`.
# Setup steps and links: docs/external-services.md

# ElevenLabs — premium narrator ("Lily"). Key needs the Text to Speech permission.
# https://elevenlabs.io/app/api/api-keys
ELEVENLABS_API_KEY=

# Gemini — six Gemini voices, Gemini Argon commentary and two Japanese voices.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (defaults shown). Read once at start-up — restart after changing.
# ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# GEMINI_VOICE_NAME=Aoede
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_ARGON_MODEL=gemini-4-argon
# GEMINI_TRANSLATE_MODEL=gemini-3.8-flash
# TTS_PROVIDER=elevenlabs   # default voice before anyone picks one: elevenlabs | gemini | gemini-argon | gemini-ja | browser
